<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Content Include="Assets\Pets\keke-corgi-v1\**\*.png"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdPartyNotices\Apache-2.0.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdPartyNotices\Sherpa-ONNX.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdPartyNotices\PdfPig.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdPartyNotices\OpenXmlSdk-MIT.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdPartyNotices\Roslyn-MIT.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\XiaoK.UiAutomation\XiaoK.UiAutomation.csproj" />
    <ProjectReference Include="..\XiaoK.Inference\XiaoK.Inference.csproj" />
    <ProjectReference Include="..\XiaoK.Voice\XiaoK.Voice.csproj" />
    <ProjectReference Include="..\XiaoK.Tools\XiaoK.Tools.csproj" />
    <ProjectReference Include="..\XiaoK.Adapters.Browser\XiaoK.Adapters.Browser.csproj" />
    <ProjectReference Include="..\XiaoK.Storage\XiaoK.Storage.csproj" />
    <Content Include="..\..\model-lock\models.lock.json" Link="model-lock\models.lock.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>

</Project>
