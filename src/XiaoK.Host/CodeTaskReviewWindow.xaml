<Window x:Class="XiaoK.Host.CodeTaskReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="审阅隔离编程补丁" Height="700" Width="900" MinHeight="480" MinWidth="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="先检查本次补丁" FontSize="20" FontWeight="SemiBold" Foreground="#20253A"/>
            <TextBlock x:Name="ProjectPathText" Margin="0,6,0,0" FontSize="11" Foreground="#68728A" TextWrapping="Wrap"/>
            <TextBlock x:Name="WorkspacePathText" Margin="0,3,0,0" FontSize="11" Foreground="#68728A" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="差异预览" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBox x:Name="DiffText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                 FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 BorderBrush="#DCE2EF" BorderThickness="1" Padding="8"/>
        <Border Grid.Row="3" Background="#FFF6DF" CornerRadius="6" Padding="9" Margin="0,10,0,10">
            <StackPanel>
            <TextBlock Text="依赖还原和验证需要你单独批准" FontWeight="SemiBold" Foreground="#654A00"/>
                <TextBlock x:Name="TestCommandText" Margin="0,4,0,0" FontFamily="Consolas" FontSize="11"
                           Foreground="#654A00" TextWrapping="Wrap"/>
                <TextBlock x:Name="TestWarningText" Margin="0,4,0,0" FontSize="11" Foreground="#654A00"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="4" LastChildFill="False">
            <Button Content="保留补丁，不运行" IsDefault="True" MinWidth="140" Padding="12,7"
                    Click="KeepPatch_Click" DockPanel.Dock="Right"/>
            <Button x:Name="RunTestsButton" Content="批准还原依赖并运行测试" MinWidth="205" Padding="12,7"
                    Margin="0,0,8,0" Click="RunTests_Click" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
