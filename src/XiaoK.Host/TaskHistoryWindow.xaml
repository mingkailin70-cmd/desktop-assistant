<Window x:Class="XiaoK.Host.TaskHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="最近任务" Height="460" Width="600" MinHeight="320" MinWidth="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="最近任务" FontSize="20" FontWeight="SemiBold" Foreground="#20253A"/>
            <TextBlock Text="这里只显示类别、状态、时间和隔离工作区路径，不保存或展示请求正文与模型回答。"
                       Margin="0,5,0,0" Foreground="#68728A" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <ListBox x:Name="HistoryList" BorderBrush="#E7EAF1" BorderThickness="1" Padding="5">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#E7EAF1" BorderThickness="0,0,0,1" Padding="8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding State}" DockPanel.Dock="Right" Foreground="#3758A6" Margin="12,0,0,0"/>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#293149" TextWrapping="Wrap"/>
                                </DockPanel>
                                <TextBlock Text="{Binding UpdatedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss} UTC}"
                                           FontSize="11" Foreground="#68728A" Margin="0,3,0,0"/>
                                <TextBox Text="{Binding Detail}" FontSize="11" Foreground="#68728A"
                                         TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         IsTabStop="True" Margin="-5,0,-5,-4" Padding="5,4"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Text="暂无可显示的本地任务记录。" Foreground="#68728A"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
        <Button Grid.Row="2" Content="关闭" IsCancel="True" MinWidth="90" HorizontalAlignment="Right" Margin="0,12,0,0"/>
    </Grid>
</Window>
