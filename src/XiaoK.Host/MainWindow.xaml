<Window x:Class="XiaoK.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小K" Height="590" Width="428" MinHeight="150" MinWidth="150"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="False"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" SizeChanged="Window_SizeChanged">
    <Border CornerRadius="26" Background="#F7F8FC" BorderBrush="#DCE2EF" BorderThickness="1"
            Padding="10" Margin="5">
        <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.22"/></Border.Effect>
        <Grid>
            <Grid x:Name="ExpandedView" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="记录" Width="38" Height="28" Click="History_Click" ToolTip="最近任务与隔离编程任务"/>
                    <Button Content="⚙" Width="30" Height="28" Click="Settings_Click" ToolTip="设置"/>
                    <Button x:Name="ExpandButton" Content="收起" Width="42" Height="28" Click="Expand_Click" ToolTip="收起到桌宠"/>
                    <Button Content="×" Width="30" Height="28" Margin="5,0,0,0" Click="Hide_Click" ToolTip="隐藏到托盘"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Background="#E8EEFF" CornerRadius="14" Width="46" Height="46">
                        <TextBlock Text="🐾" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="小K" FontSize="20" FontWeight="SemiBold" Foreground="#20253A"/>
                        <TextBlock x:Name="StatusText" Text="待命" FontSize="11" Foreground="#68728A"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1" x:Name="ExpandedPanel" Visibility="Visible">
                <TextBlock Text="说说你想做什么" FontSize="13" FontWeight="SemiBold" Foreground="#343A50" Margin="2,2,0,7"/>
                <TextBox x:Name="RequestBox" MinHeight="66" MaxHeight="100" AcceptsReturn="True" TextWrapping="Wrap" KeyDown="RequestBox_KeyDown"
                         VerticalScrollBarVisibility="Auto" FontSize="13" Padding="10"
                         ToolTip="例如：打开小K项目 / 查找文件 预算 / 分析消息：…"/>
                <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="RunButton" Content="运行" Click="Run_Click" MinWidth="76"/>
                    <Button x:Name="OpenProjectButton" Content="打开 VS Code 项目" Click="OpenProject_Click" Margin="7,0,0,0"/>
                    <Button x:Name="CancelButton" Content="取消任务" Click="Cancel_Click" Margin="7,0,0,0"/>
                    <Button x:Name="StopMicButton" Content="停麦" Click="StopMic_Click" Margin="7,0,0,0"/>
                </WrapPanel>
            </StackPanel>

            <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E7EAF1" BorderThickness="1" Margin="0,13,0,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <TextBlock x:Name="OutputText" TextWrapping="Wrap" FontSize="13" Foreground="#293149"
                               Text="当前能力状态会显示在这里。&#10;本地模型、语音和微信/QQ通知运行时尚未配置。"/>
                </ScrollViewer>
            </Border>

            <DockPanel Grid.Row="3">
                <TextBlock x:Name="FooterText" Text="本地处理 · 无云端回退" FontSize="10" Foreground="#737D92" VerticalAlignment="Center"/>
                <TextBlock Text="Ctrl+Shift+K" FontSize="10" Foreground="#737D92" HorizontalAlignment="Right"/>
            </DockPanel>
            </Grid>

            <Border x:Name="PetView" Visibility="Collapsed" Background="#EEF1FF" CornerRadius="22"
                    BorderBrush="#DCE2EF" BorderThickness="1" MouseLeftButtonDown="PetView_MouseLeftButtonDown"
                    ToolTip="单击展开任务面板；右键打开菜单">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="展开任务面板" Click="ShowPanel_Click"/>
                        <MenuItem Header="最近任务" Click="History_Click"/>
                        <MenuItem Header="设置" Click="Settings_Click"/>
                        <Separator/>
                        <MenuItem Header="取消当前任务" Click="Cancel_Click"/>
                        <MenuItem Header="停麦" Click="StopMic_Click"/>
                        <Separator/>
                        <MenuItem Header="隐藏到托盘" Click="Hide_Click"/>
                        <MenuItem Header="退出小K" Click="Exit_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Button Grid.Row="0" Click="ShowPanel_Click" Background="Transparent" BorderThickness="0"
                            Focusable="True" AutomationProperties.Name="展开小K任务面板" ToolTip="展开任务面板">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="78" Height="78" CornerRadius="39" Background="#E8EEFF" BorderBrush="#D3DCFF" BorderThickness="1">
                                <TextBlock Text="🐾" FontSize="43" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Row="1" Text="小K" FontSize="16" FontWeight="SemiBold" Foreground="#20253A"
                               HorizontalAlignment="Center" Margin="0,0,0,3"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                        <Ellipse x:Name="PetStatusDot" Width="8" Height="8" Fill="#7B8498" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="PetStatusText" Text="待命" FontSize="10" Foreground="#68728A" VerticalAlignment="Center"
                                   Width="116" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
