<Window x:Class="XiaoK.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小K" Height="650" Width="500" MinHeight="324" MinWidth="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="False"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" ShowActivated="False"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <LinearGradientBrush x:Key="PanelSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FCFCF8" Offset="0"/>
            <GradientStop Color="#F0F4EF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PanelOutlineBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#DCE7DD" Offset="0"/>
            <GradientStop Color="#EAE5DA" Offset="1"/>
        </LinearGradientBrush>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#EFF3EE"/>
            <Setter Property="Foreground" Value="#43584A"/>
            <Setter Property="BorderBrush" Value="#DCE6DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#BBD0BE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#71977E"/>
                                <Setter TargetName="ButtonChrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickPromptButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,6,5"/>
            <Setter Property="Background" Value="#E9F0E8"/>
            <Setter Property="Foreground" Value="#48634F"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="AutomationProperties.HelpText" Value="填入任务开头，可继续编辑后运行"/>
        </Style>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Background" Value="#E8EFE8"/>
            <Setter Property="Foreground" Value="#48614F"/>
        </Style>
        <Style x:Key="PetExpandButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#0A78B49D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1478B49D"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2378B49D"/>
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="ShellBorder" CornerRadius="28" Background="{StaticResource PanelSurfaceBrush}" BorderBrush="{StaticResource PanelOutlineBrush}" BorderThickness="1"
            Padding="14" Margin="5" AutomationProperties.HelpText="展开面板可拖动空白区域或柯基图；按钮、输入框、列表和滑块保留原操作">
        <Grid>
            <ScrollViewer x:Name="ExpandedViewScroller" Visibility="Visible"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
              <Grid x:Name="ExpandedView" MinWidth="440" MinHeight="560">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="任务" Width="42" Height="32" Click="History_Click" ToolTip="打开并查看任务状态"/>
                        <Button Content="⚙" Width="34" Height="32" Margin="5,0,0,0" Click="Settings_Click" ToolTip="设置"/>
                        <Button x:Name="ExpandButton" Content="收起" Width="48" Height="32" Margin="5,0,0,0"
                                Click="Expand_Click" ToolTip="收起到桌宠"/>
                        <Button Content="×" Width="34" Height="32" Margin="5,0,0,0" Click="Hide_Click" ToolTip="隐藏到托盘"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border BorderBrush="#DCE6DC" BorderThickness="1"
                                CornerRadius="17" Width="54" Height="54">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FBFCF8" Offset="0"/>
                                    <GradientStop Color="#E8EFE7" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Image Source="pack://siteoforigin:,,,/Assets/Pets/keke-corgi-v1/idle/00_420.png"
                                       Width="59" Height="59" Margin="-3" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       AutomationProperties.Name="柯基小K"/>
                                <Ellipse Width="7" Height="7" Fill="#75A47F" HorizontalAlignment="Right"
                                         VerticalAlignment="Top" Margin="0,7,7,0"/>
                            </Grid>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="小K" FontSize="20" FontWeight="SemiBold" Foreground="#20253A"/>
                            <TextBlock Text="红白柯基伙伴 · 本地运行" FontSize="11" Foreground="#6B806F" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Background="#E9F2E8" CornerRadius="10" Width="98" Padding="7,5" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#6EA47B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="StatusText" Text="待命" FontSize="11" Foreground="#386B49"
                                           VerticalAlignment="Center" MaxWidth="68" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1" BorderBrush="#DCE7DD" BorderThickness="1"
                        CornerRadius="23" Padding="0" Margin="0,0,0,11" ClipToBounds="True">
                    <Grid>
                        <Grid.MinHeight>150</Grid.MinHeight>
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#EDF3EB" Offset="0"/>
                                <GradientStop Color="#E9F0E8" Offset="0.68"/>
                                <GradientStop Color="#F2EEE5" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="1" Width="142" Height="142" Margin="0,3,0,0" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#AFC7AE" Offset="0"/>
                                    <GradientStop Color="#45E2EDE0" Offset="0.64"/>
                                    <GradientStop Color="#00E2EDE0" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="18,16,0,15">
                            <Border Background="#F9FCF8" BorderBrush="#DEE8DA" BorderThickness="1"
                                    CornerRadius="10" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,9">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#6F9D76" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="你的本地桌面伙伴" FontSize="10" Foreground="#55705A"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="你好，我是小K" FontSize="20" FontWeight="SemiBold" Foreground="#314338"/>
                            <TextBlock Text="告诉我想做什么，我们一步一步完成。"
                                       FontSize="11" Foreground="#607565" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Image x:Name="ExpandedPetImage" Grid.Column="1"
                               Source="pack://siteoforigin:,,,/Assets/Pets/keke-corgi-v1/idle/00_420.png"
                               Width="154" Height="154" Margin="0,-3,-3,-8" Stretch="Uniform"
                               VerticalAlignment="Center" Cursor="SizeAll"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="小K红白柯基角色"
                               AutomationProperties.HelpText="按住柯基图或面板空白区域拖动可移动小K窗口；控件保留原操作"
                               ToolTip="按住柯基图或面板空白区域拖动可移动小K窗口">
                            <Image.Effect>
                                <DropShadowEffect Color="#607160" BlurRadius="13" ShadowDepth="3" Opacity="0.18"/>
                            </Image.Effect>
                        </Image>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" x:Name="ExpandedPanel" Margin="0,0,0,7">
                    <TextBlock Text="今天想让小K做什么？" FontSize="14" FontWeight="SemiBold" Foreground="#35473A" Margin="2,1,0,8"/>
                    <Border Background="#FFFFFF" BorderBrush="#D9E4D9" BorderThickness="1"
                            CornerRadius="15" Padding="2">
                        <TextBox x:Name="RequestBox" MinHeight="68" MaxHeight="110" AcceptsReturn="True" TextWrapping="Wrap"
                                 KeyDown="RequestBox_KeyDown" VerticalScrollBarVisibility="Auto" FontSize="13" Padding="11"
                                 Background="Transparent" BorderThickness="0" Foreground="#293A2F"
                                 ToolTip="例如：打开小K项目 / 查找文件 预算 / 发送微信给 L：正文 / 发送QQ给 K：正文（仅预览，不发送）"/>
                    </Border>
                    <TextBlock Text="可以先点一个快捷入口，再补充细节" FontSize="10" Foreground="#7C897B" Margin="3,9,0,6"/>
                    <WrapPanel>
                        <Button Style="{StaticResource QuickPromptButton}" Content="查找文件" Tag="查找文件 " Click="QuickPrompt_Click"/>
                        <Button Style="{StaticResource QuickPromptButton}" Content="解释代码" Tag="解释代码：" Click="QuickPrompt_Click"/>
                        <Button Style="{StaticResource QuickPromptButton}" Content="分析消息" Tag="分析消息：" Click="QuickPrompt_Click"/>
                        <Button Style="{StaticResource QuickPromptButton}" Content="起草回复" Tag="帮我回复：" Click="QuickPrompt_Click"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,1,0,6">
                        <Button Style="{StaticResource QuickPromptButton}" Content="微信发送预览" Tag="发送微信给 "
                                ToolTip="补充收件人和正文；只显示预览，不会发送" Click="QuickPrompt_Click"/>
                        <Button Style="{StaticResource QuickPromptButton}" Content="QQ发送预览" Tag="发送QQ给 "
                                ToolTip="补充收件人和正文；只显示预览，不会发送" Click="QuickPrompt_Click"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,1,0,0">
                        <Button x:Name="RunButton" Content="开始任务" MinWidth="88" Click="Run_Click"
                                Background="#62876A" BorderBrush="#55775D" Foreground="White" FontWeight="SemiBold"/>
                        <Button x:Name="OpenProjectButton" Style="{StaticResource ToolButton}" Content="打开 VS Code 项目"
                                Click="OpenProject_Click"/>
                        <Button x:Name="CancelButton" Style="{StaticResource ToolButton}" Content="取消任务" Click="Cancel_Click"/>
                        <Button x:Name="StopMicButton" Style="{StaticResource ToolButton}" Content="停麦" Click="StopMic_Click"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,7,0,0">
                        <Button x:Name="SpeechButton" Style="{StaticResource ToolButton}" Content="开始说话"
                                Click="Speech_Click" ToolTip="仅点击后采集麦克风；再次点击完成转写，最长60秒"/>
                        <Button x:Name="SpeakOutputButton" Style="{StaticResource ToolButton}" Content="朗读反馈"
                                Click="SpeakOutput_Click" ToolTip="仅在点击后用本地语音朗读当前反馈"/>
                        <Button x:Name="StopSpeakingButton" Style="{StaticResource ToolButton}" Content="停止播报"
                                Click="StopSpeaking_Click" IsEnabled="False"/>
                    </WrapPanel>
                </StackPanel>

                <Border Grid.Row="3" Background="#FFFEFB" CornerRadius="17" BorderBrush="#E0E8DE"
                        BorderThickness="1" Margin="0,0,0,11">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="13,11,13,5">
                            <TextBlock Text="小K的进展" FontSize="12" FontWeight="SemiBold" Foreground="#35473A"/>
                            <TextBlock Text="临时显示 · 不保存聊天正文" FontSize="10" Foreground="#879184"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="13,5,13,13">
                            <TextBlock x:Name="OutputText" TextWrapping="Wrap" FontSize="13" Foreground="#293A30"
                                       Text="小K已待命。可以试试打开项目或查找文件；本地模型与语音尚未配置。"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <DockPanel Grid.Row="4" LastChildFill="True">
                    <TextBlock Text="Ctrl+Shift+K" FontSize="10" Foreground="#788477" DockPanel.Dock="Right"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock x:Name="FooterText" Text="本地处理 · 无云端回退" FontSize="10" Foreground="#788477"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="本地模型仅连接回环地址；未连接时不会转云端。"/>
                </DockPanel>
              </Grid>
            </ScrollViewer>

            <Border x:Name="PetView" Visibility="Collapsed" Background="Transparent" CornerRadius="30"
                    BorderBrush="Transparent" BorderThickness="0" Cursor="SizeAll"
                    AutomationProperties.Name="小K桌宠，可按住任意位置拖动；单击展开任务面板"
                    AutomationProperties.HelpText="按住桌宠任意位置并移动鼠标，松开后保存位置；右下角手柄用于缩放"
                    ToolTip="按住桌宠任意位置拖动，松开后保存位置；单击展开任务面板；右键打开菜单">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="展开任务面板" Click="ShowPanel_Click"/>
                        <MenuItem Header="任务中心" Click="History_Click"/>
                        <MenuItem Header="设置" Click="Settings_Click"/>
                        <MenuItem Header="桌宠大小" StaysOpenOnClick="True">
                            <MenuItem StaysOpenOnClick="True">
                                <MenuItem.Header>
                                    <StackPanel Width="215" Margin="4">
                                        <TextBlock x:Name="PetScaleLabel" Text="大小 70%" Margin="0,0,0,8"/>
                                        <Slider x:Name="PetScaleSlider" Minimum="40" Maximum="160" Value="70"
                                                TickFrequency="5" SmallChange="5" LargeChange="10"
                                                IsSnapToTickEnabled="True" ValueChanged="PetScaleSlider_ValueChanged"
                                                AutomationProperties.Name="桌宠大小百分比"/>
                                        <TextBlock Text="40%–160% · Ctrl+滚轮也可缩放" FontSize="11" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Header="恢复推荐大小（70%）" Click="ResetPetSize_Click"/>
                        </MenuItem>
                        <MenuItem Header="微调桌宠位置">
                            <MenuItem Header="向左移动" Click="MovePetLeft_Click"/>
                            <MenuItem Header="向右移动" Click="MovePetRight_Click"/>
                            <MenuItem Header="向上移动" Click="MovePetUp_Click"/>
                            <MenuItem Header="向下移动" Click="MovePetDown_Click"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="取消当前任务" Click="Cancel_Click"/>
                        <MenuItem Header="停麦" Click="StopMic_Click"/>
                        <Separator/>
                        <MenuItem Header="隐藏到托盘" Click="Hide_Click"/>
                        <MenuItem Header="退出小K" Click="Exit_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                <Viewbox Stretch="Uniform">
                <Grid Width="300" Height="324" Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="300"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="PetStatusBadge" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#F2F7F0" BorderBrush="#D8E4D6" BorderThickness="1"
                            CornerRadius="12" Padding="8,3" MaxWidth="174" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="PetStatusDot" Width="6" Height="6" Fill="#78A17C"
                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="PetStatusText" Text="待命" FontSize="10" Foreground="#536651"
                                       VerticalAlignment="Center" MaxWidth="146" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="CompactPetButton" Grid.Row="1" Width="300" Height="300"
                            Style="{StaticResource PetExpandButton}" Click="ShowPanel_Click"
                            Focusable="True" AutomationProperties.Name="小K桌宠，按住并拖动可移动；单击展开任务面板"
                            AutomationProperties.HelpText="键盘聚焦后按菜单键或 Shift+F10 打开菜单，用方向键选择并按 Enter 移动。"
                            ToolTip="按住小K并拖动可自由移动；轻点展开任务面板；右键菜单也可微调位置">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="PetSpriteFallback" Source="pack://siteoforigin:,,,/Assets/Pets/keke-corgi-v1/idle/00_420.png"
                                   Width="300" Height="300" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderTransformOrigin="0.5,0.88"
                                   AutomationProperties.Name="柯基小K，红白毛色与绿色星星围巾">
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="PetFallbackPoseScale"/>
                                        <TranslateTransform x:Name="PetFallbackPoseOffset"/>
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>
                            <Viewbox x:Name="PetAnimationViewbox" Width="300" Height="300"
                                     Stretch="Uniform" Opacity="0" IsHitTestVisible="False"
                                     RenderTransformOrigin="0.5,0.88"
                                     AutomationProperties.Name="柯基动画桌宠小K"
                                     Loaded="PetAnimationViewbox_Loaded">
                                <Viewbox.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="PetAnimationPoseScale"/>
                                        <TranslateTransform x:Name="PetAnimationPoseOffset"/>
                                    </TransformGroup>
                                </Viewbox.RenderTransform>
                                <ContentControl x:Name="PetAnimationHost" />
                            </Viewbox>
                        </Grid>
                    </Button>
                </Grid>
                </Viewbox>
                <Thumb x:Name="PetResizeHandle" Width="24" Height="24" HorizontalAlignment="Right"
                       VerticalAlignment="Bottom" Margin="0,0,2,2" Cursor="SizeNWSE" Focusable="False"
                       Opacity="0.4"
                       ToolTip="拖动调整桌宠大小" AutomationProperties.Name="拖动调整桌宠大小"
                       DragStarted="PetResize_DragStarted" DragDelta="PetResize_DragDelta"
                       DragCompleted="PetResize_DragCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="ResizeChrome" Background="Transparent" CornerRadius="12"
                                    BorderBrush="Transparent" BorderThickness="1">
                                <Path Data="M 8,16 L 16,8 M 12,16 L 16,12" Stroke="#536651" StrokeThickness="1.6"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ResizeChrome" Property="Background" Value="#DFF8FBF7"/>
                                    <Setter TargetName="ResizeChrome" Property="BorderBrush" Value="#B8C8B9"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
