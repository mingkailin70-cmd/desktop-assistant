<Window x:Class="XiaoK.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小K" Height="650" Width="500" MinHeight="372" MinWidth="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="False"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <Style x:Key="QuickPromptButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,7,7"/>
            <Setter Property="Background" Value="#EAF4F0"/>
            <Setter Property="Foreground" Value="#35584F"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="AutomationProperties.HelpText" Value="填入任务开头，可继续编辑后运行"/>
        </Style>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Background" Value="#E6F0EC"/>
            <Setter Property="Foreground" Value="#2F4D45"/>
        </Style>
        <Style x:Key="PetExpandButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1A78B49D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3478B49D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="ShellBorder" CornerRadius="26" Background="#FBFCFE" BorderBrush="#DDE4ED" BorderThickness="1"
            Padding="14" Margin="5">
        <Grid>
            <ScrollViewer x:Name="ExpandedViewScroller" Visibility="Visible"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
              <Grid x:Name="ExpandedView" MinWidth="440" MinHeight="560">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,14"
                           MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="记录" Width="42" Height="32" Click="History_Click" ToolTip="最近任务与隔离编程任务"/>
                        <Button Content="⚙" Width="34" Height="32" Margin="5,0,0,0" Click="Settings_Click" ToolTip="设置"/>
                        <Button x:Name="ExpandButton" Content="收起" Width="48" Height="32" Margin="5,0,0,0"
                                Click="Expand_Click" ToolTip="收起到桌宠"/>
                        <Button Content="×" Width="34" Height="32" Margin="5,0,0,0" Click="Hide_Click" ToolTip="隐藏到托盘"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border BorderBrush="#DCE8E2" BorderThickness="1"
                                CornerRadius="18" Width="58" Height="58">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F7F9FC" Offset="0"/>
                                    <GradientStop Color="#E5EBF3" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Image Source="/XiaoK.Host;component/Assets/Pets/xiaok-silver-shaded-3d-v10-wave.png"
                                       Width="62" Height="62" Margin="-4" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       AutomationProperties.Name="银渐层小猫小K"/>
                                <Ellipse Width="6" Height="6" Fill="#FFD66B" HorizontalAlignment="Right"
                                         VerticalAlignment="Top" Margin="0,7,7,0"/>
                            </Grid>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="小K" FontSize="20" FontWeight="SemiBold" Foreground="#20253A"/>
                            <TextBlock Text="银渐层小猫 · 本地伙伴" FontSize="11" Foreground="#62796F" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Background="#E8F3EC" CornerRadius="10" Width="98" Padding="7,5" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#57A370" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="StatusText" Text="待命" FontSize="11" Foreground="#386B49"
                                           VerticalAlignment="Center" MaxWidth="68" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1" BorderBrush="#DCE3ED" BorderThickness="1"
                        CornerRadius="22" Padding="0" Margin="0,0,0,13" ClipToBounds="True">
                    <Grid>
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F5F8FC" Offset="0"/>
                                <GradientStop Color="#E6EDF5" Offset="0.72"/>
                                <GradientStop Color="#EEF0F8" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="116"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="16,13,0,13">
                            <Border Background="#FFFFFF" BorderBrush="#DFE6EF" BorderThickness="1"
                                    CornerRadius="10" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#67A992" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="银渐层小K · 本地助手" FontSize="10" Foreground="#587368"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="你好，我是小K" FontSize="17" FontWeight="SemiBold" Foreground="#354252"/>
                            <TextBlock Text="把想做的事告诉我，我们一起完成。"
                                       FontSize="11" Foreground="#60766D" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Image Grid.Column="1" Source="/XiaoK.Host;component/Assets/Pets/xiaok-silver-shaded-3d-v10-wave.png"
                               Width="122" Height="122" Margin="0,-2,-2,-7" Stretch="Uniform"
                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="小K银渐层小猫形象">
                            <Image.Effect>
                                <DropShadowEffect Color="#667487" BlurRadius="12" ShadowDepth="3" Opacity="0.17"/>
                            </Image.Effect>
                        </Image>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" x:Name="ExpandedPanel" Margin="0,0,0,11">
                    <TextBlock Text="你想做什么？" FontSize="13" FontWeight="SemiBold" Foreground="#343A50" Margin="2,0,0,7"/>
                    <TextBox x:Name="RequestBox" MinHeight="74" MaxHeight="110" AcceptsReturn="True" TextWrapping="Wrap"
                             KeyDown="RequestBox_KeyDown" VerticalScrollBarVisibility="Auto" FontSize="13" Padding="11"
                             Background="White" BorderBrush="#DCE2EF"
                             ToolTip="例如：打开小K项目 / 查找文件 预算 / 发送微信给 L：正文 / 发送QQ给 K：正文（仅预览，不发送）"/>
                    <TextBlock Text="快捷入口 · 点一下后补充内容" FontSize="10" Foreground="#7A8299" Margin="2,9,0,6"/>
                    <WrapPanel>
                        <Button Style="{StaticResource QuickPromptButton}" Content="查找文件" Tag="查找文件 " Click="QuickPrompt_Click"/>
                        <Button Style="{StaticResource QuickPromptButton}" Content="解释代码" Tag="解释代码：" Click="QuickPrompt_Click"/>
                        <Button Style="{StaticResource QuickPromptButton}" Content="分析消息" Tag="分析消息：" Click="QuickPrompt_Click"/>
                        <Button Style="{StaticResource QuickPromptButton}" Content="起草回复" Tag="帮我回复：" Click="QuickPrompt_Click"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,1,0,6">
                        <Button Style="{StaticResource QuickPromptButton}" Content="微信发送预览" Tag="发送微信给 "
                                ToolTip="补充收件人和正文；只显示预览，不会发送" Click="QuickPrompt_Click"/>
                        <Button Style="{StaticResource QuickPromptButton}" Content="QQ发送预览" Tag="发送QQ给 "
                                ToolTip="补充收件人和正文；只显示预览，不会发送" Click="QuickPrompt_Click"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,1,0,0">
                        <Button x:Name="RunButton" Content="运行任务" MinWidth="82" Click="Run_Click"
                                Background="#579A83" Foreground="White" FontWeight="SemiBold"/>
                        <Button x:Name="OpenProjectButton" Style="{StaticResource ToolButton}" Content="打开 VS Code 项目"
                                Click="OpenProject_Click"/>
                        <Button x:Name="CancelButton" Style="{StaticResource ToolButton}" Content="取消任务" Click="Cancel_Click"/>
                        <Button x:Name="StopMicButton" Style="{StaticResource ToolButton}" Content="停麦" Click="StopMic_Click"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,7,0,0">
                        <Button x:Name="SpeechButton" Style="{StaticResource ToolButton}" Content="开始说话"
                                Click="Speech_Click" ToolTip="仅点击后采集麦克风；再次点击完成转写，最长60秒"/>
                        <Button x:Name="SpeakOutputButton" Style="{StaticResource ToolButton}" Content="朗读反馈"
                                Click="SpeakOutput_Click" ToolTip="仅在点击后用本地语音朗读当前反馈"/>
                        <Button x:Name="StopSpeakingButton" Style="{StaticResource ToolButton}" Content="停止播报"
                                Click="StopSpeaking_Click" IsEnabled="False"/>
                    </WrapPanel>
                </StackPanel>

                <Border Grid.Row="3" Background="White" CornerRadius="15" BorderBrush="#E1EBE6"
                        BorderThickness="1" Margin="0,0,0,11">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="13,11,13,5">
                            <TextBlock Text="任务反馈" FontSize="12" FontWeight="SemiBold" Foreground="#343A50"/>
                            <TextBlock Text="临时显示 · 不保存聊天正文" FontSize="10" Foreground="#8A91A4"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="13,5,13,13">
                            <TextBlock x:Name="OutputText" TextWrapping="Wrap" FontSize="13" Foreground="#293149"
                                       Text="小K已待命。可以试试打开项目或查找文件；本地模型与语音尚未配置。"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <DockPanel Grid.Row="4" LastChildFill="True">
                    <TextBlock Text="Ctrl+Shift+K" FontSize="10" Foreground="#737D92" DockPanel.Dock="Right"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock x:Name="FooterText" Text="本地处理 · 无云端回退" FontSize="10" Foreground="#737D92"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="本地模型仅连接回环地址；未连接时不会转云端。"/>
                </DockPanel>
              </Grid>
            </ScrollViewer>

            <Border x:Name="PetView" Visibility="Collapsed" Background="Transparent" CornerRadius="30"
                    BorderBrush="Transparent" BorderThickness="0" MouseLeftButtonDown="PetView_MouseLeftButtonDown"
                    ToolTip="单击展开任务面板；拖动可调整位置；右键打开菜单">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="展开任务面板" Click="ShowPanel_Click"/>
                        <MenuItem Header="最近任务" Click="History_Click"/>
                        <MenuItem Header="设置" Click="Settings_Click"/>
                        <Separator/>
                        <MenuItem Header="取消当前任务" Click="Cancel_Click"/>
                        <MenuItem Header="停麦" Click="StopMic_Click"/>
                        <Separator/>
                        <MenuItem Header="隐藏到托盘" Click="Hide_Click"/>
                        <MenuItem Header="退出小K" Click="Exit_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid Margin="3,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Background="#F5FFFFFF" BorderBrush="#B9FFFFFF" BorderThickness="1"
                            CornerRadius="15" Padding="11,6" Margin="0,9,0,0" MaxWidth="260">
                        <Border.Effect>
                            <DropShadowEffect Color="#52617A" BlurRadius="14" ShadowDepth="3" Opacity="0.14"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="PetStatusDot" Width="7" Height="7" Fill="#7B8498"
                                     VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="PetStatusText" Text="待命" FontSize="10" Foreground="#4F5D70"
                                       VerticalAlignment="Center" Width="214" TextTrimming="CharacterEllipsis"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Grid.Row="1" Style="{StaticResource PetExpandButton}" Click="ShowPanel_Click"
                            Focusable="True" AutomationProperties.Name="展开小K任务面板" ToolTip="展开任务面板">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="250" Height="206" Margin="0,22,0,0" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#55D8EEE4" Offset="0"/>
                                        <GradientStop Color="#19D8EEE4" Offset="0.63"/>
                                        <GradientStop Color="#00D8EEE4" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="180" Height="146" Margin="0,51,0,0" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Color="#45FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Image Source="/XiaoK.Host;component/Assets/Pets/xiaok-silver-shaded-3d-v10-wave.png"
                                   Width="270" Height="270" Margin="0,9,0,0" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.Name="3D银渐层小猫小K">
                                <Image.Effect>
                                    <DropShadowEffect Color="#667487" BlurRadius="18" ShadowDepth="6" Opacity="0.22"/>
                                </Image.Effect>
                            </Image>
                        </Grid>
                    </Button>
                    <Border Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Background="#F5FFFFFF" BorderBrush="#B9FFFFFF" BorderThickness="1"
                            CornerRadius="17" Padding="17,7" Margin="0,0,0,8">
                        <Border.Effect>
                            <DropShadowEffect Color="#52617A" BlurRadius="14" ShadowDepth="3" Opacity="0.13"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="14" Background="#EAF0F6" Margin="0,0,9,0"
                                    AutomationProperties.Name="小K猫爪标记">
                                <Canvas Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Canvas.Left="1" Canvas.Top="4" Width="4.5" Height="5.5" Fill="#71889D"/>
                                    <Ellipse Canvas.Left="5.5" Canvas.Top="0.5" Width="4.5" Height="5.5" Fill="#71889D"/>
                                    <Ellipse Canvas.Left="10.5" Canvas.Top="0.5" Width="4.5" Height="5.5" Fill="#71889D"/>
                                    <Ellipse Canvas.Left="14" Canvas.Top="4" Width="4" Height="5.5" Fill="#71889D"/>
                                    <Ellipse Canvas.Left="4" Canvas.Top="8" Width="10.5" Height="8" Fill="#71889D"/>
                                </Canvas>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="小K" FontSize="13" FontWeight="SemiBold" Foreground="#263247"/>
                                <TextBlock Text="点我展开 · 右键菜单" FontSize="9" Foreground="#768397" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
