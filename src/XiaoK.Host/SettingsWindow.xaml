<Window x:Class="XiaoK.Host.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小K设置" Width="560" Height="740" MinWidth="520" MinHeight="650"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F7F8FC" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="小K设置" FontSize="22" FontWeight="SemiBold" Foreground="#20253A"/>
            <TextBlock Text="路径保存在当前 Windows 用户配置中；模型推理地址只能使用本机回环地址。"
                       Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#68728A"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="本地存储" FontSize="15" FontWeight="SemiBold" Foreground="#343A50" Margin="0,0,0,8"/>
                <TextBlock Text="用户数据目录"/>
                <DockPanel Margin="0,4,0,12">
                    <Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseDataRoot_Click" Margin="8,0,0,0"/>
                    <TextBox x:Name="DataRootBox" MinHeight="32" Padding="7,5"/>
                </DockPanel>
                <TextBlock Text="模型目录（供后续本地推理运行时使用）"/>
                <DockPanel Margin="0,4,0,12">
                    <Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseModelRoot_Click" Margin="8,0,0,0"/>
                    <TextBox x:Name="ModelRootBox" MinHeight="32" Padding="7,5"/>
                </DockPanel>
                <TextBlock Text="脱敏评测样本目录"/>
                <DockPanel Margin="0,4,0,12">
                    <Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseEvaluationRoot_Click" Margin="8,0,0,0"/>
                    <TextBox x:Name="EvaluationRootBox" MinHeight="32" Padding="7,5"/>
                </DockPanel>
                <Button x:Name="ClearSamplesButton" Content="清理评测样本…" Click="ClearSamples_Click"
                        HorizontalAlignment="Left" Margin="0,0,0,4"/>
                <TextBlock x:Name="PrivacyStatusText" FontSize="11" Foreground="#68728A" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <Separator Margin="0,0,0,12"/>
                <TextBlock Text="本地编程代理" FontSize="15" FontWeight="SemiBold" Foreground="#343A50" Margin="0,0,0,8"/>
                <TextBlock Text="本次允许处理的项目目录（由你选择；模型不能更改路径）"/>
                <DockPanel Margin="0,4,0,10">
                    <Button DockPanel.Dock="Right" Content="选择项目…" Click="BrowseCodeProject_Click" Margin="8,0,0,0"/>
                    <TextBox x:Name="CodeProjectRootBox" MinHeight="32" Padding="7,5"/>
                </DockPanel>
                <TextBlock Text="隔离工作区目录（原项目不会被代理直接修改）"/>
                <DockPanel Margin="0,4,0,4">
                    <Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseCodeWorkspace_Click" Margin="8,0,0,0"/>
                    <TextBox x:Name="CodeWorkspaceRootBox" MinHeight="32" Padding="7,5"/>
                </DockPanel>
                <TextBlock Text="最多选择4个文本文件生成隔离补丁。你可先审阅差异；只有单独批准时，才会对唯一 .NET 解决方案/项目执行固定依赖还原与测试命令。"
                           FontSize="11" Foreground="#68728A" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <TextBlock Text="本地推理服务地址"/>
                <TextBox x:Name="InferenceEndpointBox" MinHeight="32" Padding="7,5" Margin="0,4,0,5"/>
                <TextBlock Text="只允许 localhost / 127.0.0.1 / ::1；远程服务会被拒绝。"
                           FontSize="11" Foreground="#68728A" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <Separator Margin="0,0,0,12"/>
                <TextBlock Text="联系人回复风格" FontSize="15" FontWeight="SemiBold" Foreground="#343A50" Margin="0,0,0,6"/>
                <TextBlock Text="只保存你填写的联系人名称、固定风格、确认来源和更新时间；不保存聊天正文。起草时可输入“帮我回复给联系人名：消息内容”。"
                           FontSize="11" Foreground="#68728A" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="联系人名称" FontSize="11"/>
                <TextBox x:Name="ContactStyleNameBox" MinHeight="32" Padding="7,5" Margin="0,0,0,6"
                         ToolTip="联系人名称，最多80个字符"/>
                <TextBlock Text="回复风格" FontSize="11"/>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="添加 / 更新" Click="AddContactStyle_Click" Margin="8,0,0,0"/>
                    <ComboBox x:Name="ContactStyleBox" MinHeight="32" Padding="5"/>
                </DockPanel>
                <ListBox x:Name="ContactStylesList" Height="112" SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,3">
                                <TextBlock Text="{Binding ContactName}" FontWeight="SemiBold"/>
                                <TextBlock FontSize="11" Foreground="#68728A">
                                    <Run Text="{Binding StyleDisplayName}"/>
                                    <Run Text=" · 来源："/>
                                    <Run Text="{Binding SourceDisplayName}"/>
                                    <Run Text=" · 更新："/>
                                    <Run Text="{Binding UpdatedAtUtc}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="删除选中的风格偏好" Click="RemoveContactStyle_Click" HorizontalAlignment="Left" Margin="0,5,0,2"/>
                <TextBlock x:Name="ContactStyleStatusText" FontSize="11" Foreground="#68728A" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <Separator Margin="0,0,0,14"/>
                <TextBlock Text="登录与能力状态" FontSize="15" FontWeight="SemiBold" Foreground="#343A50" Margin="0,0,0,8"/>
                <CheckBox x:Name="StartupCheck" Content="登录 Windows 后在托盘启动小K" Margin="0,0,0,4"/>
                <TextBlock x:Name="StartupStatusText" FontSize="11" Foreground="#68728A" TextWrapping="Wrap" Margin="22,0,0,12"/>
                <Border Background="White" BorderBrush="#E7EAF1" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="麦克风：未接入，当前不会采集" Margin="0,0,0,5"/>
                        <TextBlock Text="微信 / QQ 通知监听" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <CheckBox x:Name="MonitorWeChatCheck" Content="监听微信通知" Margin="0,0,0,4"/>
                        <TextBlock Text="微信发布者 AUMID（每行一个，必须核实后填写）" FontSize="11"/>
                        <TextBox x:Name="WeChatAppIdsBox" MinHeight="44" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,3,0,7"/>
                        <CheckBox x:Name="MonitorQQCheck" Content="监听 QQ 通知" Margin="0,0,0,4"/>
                        <TextBlock Text="QQ 发布者 AUMID（每行一个，必须核实后填写）" FontSize="11"/>
                        <TextBox x:Name="QQAppIdsBox" MinHeight="44" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,3,0,6"/>
                        <Button x:Name="RequestNotificationAccessButton" Content="请求 Windows 通知访问权限" Click="RequestNotificationAccess_Click" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                        <TextBlock x:Name="NotificationStatusText" FontSize="11" Foreground="#68728A" TextWrapping="Wrap" Margin="0,0,0,9"/>
                        <TextBlock Text="资源读数按需采样；刷新时不会加载模型或启动后台监控。" TextWrapping="Wrap"/>
                        <Button x:Name="RefreshResourcesButton" Content="刷新 CPU / 内存 / NVIDIA 显存" Click="RefreshResources_Click"
                                HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        <TextBlock x:Name="ResourceStatusText" Text="尚未采样。NVIDIA 显存显示系统总量，不代表小K进程占用。"
                                   FontSize="11" Foreground="#68728A" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="数据、模型、评测、编程项目和隔离工作区路径及推理地址保存后需重启小K生效；登录启动设置立即生效。清理只删除评测目录顶层普通文件，并在执行前再次确认。"
                           FontSize="11" Foreground="#68728A" TextWrapping="Wrap" Margin="0,10,0,4"/>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#A33A32" TextWrapping="Wrap"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" IsCancel="True" MinWidth="80" Margin="0,0,8,0"/>
                <Button Content="保存" IsDefault="True" MinWidth="90" Click="Save_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
