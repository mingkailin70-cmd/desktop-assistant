<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 仅从 nuget.org 获取明确列出的 SDK、运行时与浏览器自动化包；勿添加通配映射。 -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.Windows.SDK.NET.Ref" />
      <package pattern="Microsoft.NETCore.App.Runtime.win-x64" />
      <package pattern="Microsoft.WindowsDesktop.App.Runtime.win-x64" />
      <package pattern="Microsoft.AspNetCore.App.Runtime.win-x64" />
      <package pattern="Microsoft.NETCore.App.Host.win-x64" />
      <package pattern="Microsoft.Playwright" />
      <package pattern="Microsoft.Bcl.AsyncInterfaces" />
      <package pattern="System.ComponentModel.Annotations" />
    </packageSource>
  </packageSourceMapping>
  <auditSources><clear /></auditSources>
</configuration>
